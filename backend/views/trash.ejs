<%- include('partials/header', { title: 'Thùng rác' }) %>
<main id="main-content" class="dashboard">
  <div class="page-heading"><div><p class="eyebrow">QUẢN LÝ HỒ SƠ</p><h1>Thùng rác <span class="count-badge"><%= students.length %></span></h1><p class="subtitle">Hồ sơ được giữ lại để bạn có thể khôi phục bất cứ lúc nào.</p></div><a class="button button-secondary" href="/students">← Danh sách</a></div>
  <section class="panel archive-panel">
    <% if (!students.length) { %><div class="empty-state"><span class="empty-icon" aria-hidden="true">↺</span><h3>Thùng rác đang trống</h3><p>Các hồ sơ đã xóa sẽ xuất hiện tại đây.</p></div><% } else { %>
    <div class="table-scroll"><table><thead><tr><th>ID</th><th>SINH VIÊN</th><th>CHUYỂN VÀO THÙNG RÁC</th><th>THAO TÁC</th></tr></thead><tbody>
      <% for (const student of students) { %><tr><td><%= formatStudentId(student.id) %></td><td><strong><%= student.name %></strong><p class="muted"><%= student.email %></p></td><td><%= formatTime(student.deletedAt) %></td><td><form action="/students/<%= encodeURIComponent(student.id) %>/restore" method="post"><button class="button button-primary" type="submit">↺ Khôi phục</button></form></td></tr><% } %>
    </tbody></table></div><% } %>
  </section>
</main>
<%- include('partials/footer') %>
