<dialog id="delete-dialog" class="delete-dialog" aria-label="Xác nhận xóa sinh viên" aria-describedby="delete-dialog-message">
  <div class="delete-dialog-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M9 6V4h6v2M5 6l1 14h12l1-14M10 10v6M14 10v6"/></svg>
  </div>
  <p id="delete-dialog-message">Chuyển sinh viên này vào thùng rác? Bạn có thể khôi phục sau.</p>
  <div class="delete-dialog-actions">
    <button class="button button-secondary" type="button" data-delete-answer="cancel" autofocus>Hủy</button>
    <button class="button button-danger" type="button" data-delete-answer="confirm">Chuyển vào thùng rác</button>
  </div>
</dialog>
